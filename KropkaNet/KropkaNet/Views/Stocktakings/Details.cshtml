@model KropkaNet.Objects.Entities.Models.CompanySide.Stocktaking

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Stocktaking - @Model.Id</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Expecteed Time
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ExpectedTimeHours)
        </dd>
        <dt class = "col-sm-2">
            Warehouse ID
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.WarehouseId)
        </dd>
        <dt class = "col-sm-2">
            Order
        </dt>
        <dd class = "col-sm-10">
            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">@Model.OrderId</a>
        </dd>
        <dt class="col-sm-2">
            Notes
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
